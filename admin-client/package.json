{
  "name": "@rms/admin-client",
  "version": "1.0.0",
  "type": "module",
  "description": "RMS House Rental System - Admin Desktop Client (Electron)",
  "private": true,
  "main": "out/main/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron-dev": "vite && electron .",
    "package": "electron-builder",
    "lint": "eslint src --ext js,jsx"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "better-sqlite3": "^9.4.0",
    "axios": "^1.6.2",
    "zustand": "^4.4.1",
    "tailwindcss": "^3.3.5",
    "framer-motion": "^10.16.4",
    "react-icons": "^4.12.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.6.4",
    "@vitejs/plugin-react": "^4.1.0",
    "vite": "^5.0.2",
    "eslint": "^8.50.0"
  },
  "build": {
    "appId": "com.rms.admin",
    "productName": "RMS Admin",
    "files": [
      "out/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
