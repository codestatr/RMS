# Copy to .env before running Docker Compose.
MYSQL_DATABASE=rms_database
MYSQL_USER=rms
MYSQL_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_root_password

JWT_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

BUSINESS_NAME=RMS House Rental Management
BUSINESS_EMAIL=support@rms-rentals.com
BUSINESS_PHONE=+254 700 000000
USD_TO_KES_RATE=130
TAX_RATE=0.16

# Host ports. Change these if the PC already uses 3000 or 8080.
BACKEND_PORT=3000
FRONTEND_PORT=8080
CORS_ORIGIN=http://localhost:8080
