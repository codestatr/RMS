# Copy to .env before running Docker Compose.
MYSQL_DATABASE=rms_database
MYSQL_USER=rms
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Optional first administrator bootstrap. Leave blank to create no account.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=
INITIAL_ADMIN_LAST_NAME=

BUSINESS_NAME=CozyStay
BUSINESS_EMAIL=
BUSINESS_PHONE=
USD_TO_KES_RATE=130
TAX_RATE=0.16

# SMTP mail delivery used for staff recovery codes and login OTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Host ports. Change these if the PC already uses 3000 or 8080.
BACKEND_PORT=3000
FRONTEND_PORT=8080
CORS_ORIGIN=http://localhost:8080
