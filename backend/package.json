{
  "name": "@rms/backend",
  "version": "1.0.0",
  "description": "RMS House Rental System - Backend API (Node.js/Express)",
  "private": true,
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node src/app.js",
    "dev:watch": "nodemon --watch src --ext js,mjs,json --exec node src/app.js",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand --testPathIgnorePatterns=backend/test.js",
    "test:watch": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --watch --testPathIgnorePatterns=backend/test.js",
    "lint": "eslint src/**/*.js",
    "build": "echo Backend ready",
    "migrate": "node src/migrations/migrate.js",
    "seed": "node src/database/seed.js"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.0",
    "firebase": "^10.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "moment-timezone": "^0.5.45",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql2": "^3.6.5",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.17.2",
    "stripe": "^14.5.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
