PORT=3000
NODE_ENV=development

# Safaricom Daraja M-Pesa (sandbox for local development)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Use a public HTTPS tunnel to your local API, e.g. https://<tunnel-host>/api/payments/webhook/mpesa
MPESA_CALLBACK_URL=

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rms_database

# JWT Secret Keys
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Optional first administrator bootstrap (no default account is created)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=
INITIAL_ADMIN_LAST_NAME=

# System Financial Settings
DEFAULT_CURRENCY=KES
USD_TO_KES_RATE=130
TAX_RATE=0.16
BUSINESS_NAME="CozyStay"
BUSINESS_EMAIL=
BUSINESS_PHONE=

# SMTP mail delivery (required for staff password recovery and login OTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
