# System Financial Settings
DEFAULT_CURRENCY=KES
USD_TO_KES_RATE=130
TAX_RATE=0.16
BUSINESS_NAME="RMS House Rental & Management"
BUSINESS_EMAIL="support@rms-rentals.com"
BUSINESS_PHONE="+254 700 000000"

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
