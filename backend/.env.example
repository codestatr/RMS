PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rms_database

# JWT Secret Keys
JWT_SECRET=super_secret_rms_jwt_access_key_2026_!@#$
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_rms_jwt_refresh_key_2026_!@#$
