<Window x:Class="RMS.POSSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RMS Point of Sale Terminal" 
        Height="700" Width="1100" 
        WindowStartupLocation="CenterScreen"
        Background="#F5F7F8" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#FFFDF4" BorderBrush="#E4E9ED" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F59E0B" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                        <!-- ASSET NEEDED: official RMS logo. -->
                        <TextBlock Text="Logo pending" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RMS POS Terminal" FontWeight="Bold" FontSize="15" Foreground="#111827"/>
                        <TextBlock Text="Local SQLite Node (WAL Mode)" FontSize="10" Foreground="#6B7280"/>
                    </StackPanel>
                </StackPanel>

                <!-- Active Shift & Status Banner -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="ShiftStatusBadge" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtShiftStatus" Text="Shift: Active" FontSize="11" FontWeight="Bold" Foreground="#065F46"/>
                    </Border>

                    <Button Content="Sync Now" Background="#F3F4F6" Foreground="#374151" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,4" FontSize="11" FontWeight="SemiBold" Click="BtnSync_Click"/>
                </StackPanel>

                <!-- User Profile & Sign Out -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCashierName" Text="Cashier Name" TextAlignment="Right" FontWeight="Bold" FontSize="12" Foreground="#111827"/>
                        <TextBlock x:Name="TxtCashierRole" Text="Cashier Role" TextAlignment="Right" FontSize="10" Foreground="#6B7280"/>
                    </StackPanel>
                    <Button Content="Sign Out" Background="#FEE2E2" Foreground="#991B1B" BorderThickness="0" Padding="12,6" FontSize="11" FontWeight="Bold" Click="BtnSignOut_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Navigation Sidebar + Content Container -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="#17202A" BorderBrush="#2D3B47" BorderThickness="0,0,1,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="POS TERMINAL MENU" FontSize="9" FontWeight="Bold" Foreground="#B9C4CC" Margin="8,8,8,10"/>
                    
                    <Button x:Name="NavBooking" Content="Walk-In Booking" Height="38" Background="#F59E0B" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Margin="0,2" HorizontalContentAlignment="Left" Padding="10,0" Click="NavBooking_Click"/>
                    <Button x:Name="NavShift" Content="Shift Management" Height="38" Background="#24313D" Foreground="#E6EDF1" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Margin="0,2" HorizontalContentAlignment="Left" Padding="10,0" Click="NavShift_Click"/>
                    <Button x:Name="NavTransactions" Content="Transactions History" Height="38" Background="Transparent" Foreground="#E6EDF1" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Margin="0,2" HorizontalContentAlignment="Left" Padding="10,0" Click="NavTransactions_Click"/>
                    
                    <TextBlock x:Name="LblAdminSection" Text="ADMINISTRATOR" FontSize="9" FontWeight="Bold" Foreground="#B9C4CC" Margin="8,18,8,6"/>
                    <Button x:Name="NavAdmin" Content="Shift Oversight" Height="38" Background="Transparent" Foreground="#E6EDF1" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Margin="0,2" HorizontalContentAlignment="Left" Padding="10,0" Click="NavAdmin_Click"/>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Column="1" x:Name="MainContentContainer" Margin="15">
                <!-- UserControls loaded dynamically -->
            </Grid>
        </Grid>
    </Grid>
</Window>
