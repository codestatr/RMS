<UserControl x:Class="RMS.POSSystem.Views.PaymentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Payment Method & Tender Amount in KES -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <Button Content="&larr; Back to Booking Details" Background="Transparent" Foreground="#6B7280" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,10" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="BtnBack_Click"/>
                <TextBlock Text="Collect Payment (KES)" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,15"/>

                <!-- Method Buttons -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnMethodCash" Grid.Column="0" Content="💵 Cash (KES)" Height="40" Background="#F59E0B" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Margin="2" Click="BtnMethodCash_Click"/>
                    <Button x:Name="BtnMethodCard" Grid.Column="1" Content="💳 Card (KES)" Height="40" Background="#F3F4F6" Foreground="#374151" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Margin="2" Click="BtnMethodCard_Click"/>
                    <Button x:Name="BtnMethodMpesa" Grid.Column="2" Content="📱 M-Pesa (KES)" Height="40" Background="#F3F4F6" Foreground="#374151" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Margin="2" Click="BtnMethodMpesa_Click"/>
                </Grid>

                <!-- Cash Tender Input Section in KES -->
                <StackPanel x:Name="CashPanel" Margin="0,0,0,15">
                    <TextBlock Text="Amount Tendered / Received (KES)" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtTendered" Height="36" Padding="8,6" FontSize="14" FontWeight="Bold" Text="6380.00" TextChanged="TxtTendered_TextChanged"/>

                    <!-- Quick Cash KES Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Exact" Height="28" Padding="8,0" Margin="0,0,4,0" Background="#F3F4F6" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Click="BtnQuickExact_Click"/>
                        <Button Content="1,000" Height="28" Padding="8,0" Margin="0,0,4,0" Background="#F3F4F6" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Click="BtnQuick1000_Click"/>
                        <Button Content="2,000" Height="28" Padding="8,0" Margin="0,0,4,0" Background="#F3F4F6" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Click="BtnQuick2000_Click"/>
                        <Button Content="5,000" Height="28" Padding="8,0" Margin="0,0,4,0" Background="#F3F4F6" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Click="BtnQuick5000_Click"/>
                        <Button Content="10,000" Height="28" Padding="8,0" Margin="0,0,4,0" Background="#F3F4F6" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Click="BtnQuick10000_Click"/>
                    </StackPanel>

                    <!-- Change Return Display -->
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,15,0,0">
                        <Grid>
                            <TextBlock Text="Change Due to Customer:" FontSize="12" FontWeight="Bold" Foreground="#065F46" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtChange" Text="KES 0.00" FontSize="16" FontWeight="ExtraBold" Foreground="#065F46" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Electronic Ref Section (for Card / M-Pesa) -->
                <StackPanel x:Name="RefPanel" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Text="Card / Mobile Money (M-Pesa) Transaction Ref" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtRef" Height="36" Padding="8,6" FontSize="12" Text="MPESA_QK9982187"/>
                </StackPanel>
            </StackPanel>

            <!-- Right: Receipt Summary & Complete Action in KES -->
            <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="15">
                <StackPanel VerticalAlignment="SpaceBetween">
                    <StackPanel>
                        <TextBlock Text="Transaction Details (KES)" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,10"/>

                        <TextBlock x:Name="TxtPropSummary" Text="Luxury 1-Bedroom Apartment" FontSize="12" FontWeight="Bold" Foreground="#1F2937"/>
                        <TextBlock x:Name="TxtGuestSummary" Text="Guest: David Kamau" FontSize="11" Foreground="#4B5563" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TxtDatesSummary" Text="2026-09-05 to 2026-09-08 (3 Nights)" FontSize="11" Foreground="#6B7280" Margin="0,2,0,10"/>

                        <Separator Background="#E5E7EB" Margin="0,4,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Amount Due:" FontSize="12" Foreground="#4B5563"/>
                            <TextBlock x:Name="TxtAmountDue" Text="KES 6,380.00" FontSize="15" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <Button x:Name="BtnCompleteTransaction" Content="✓ Complete &amp; Print Receipt" Height="44" Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Click="BtnCompleteTransaction_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
