<Window x:Class="RMS.POSSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RMS POS - Staff Sign In" 
        Height="450" Width="400" 
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize">
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">
            <!-- Brand -->
            <Border Background="#F59E0B" Width="50" Height="50" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,10">
                <!-- ASSET NEEDED: official RMS logo. -->
                <TextBlock Text="Logo pending" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            
            <TextBlock Text="RMS POS" FontSize="20" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center"/>
            <TextBlock Text="Sign in to continue" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,20"/>

            <!-- Email / Username -->
            <TextBlock Text="Email or username" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsername" Height="36" Padding="8,6" FontSize="12" BorderBrush="#D1D5DB" Margin="0,0,0,12"/>

            <!-- Password -->
            <TextBlock Text="Password" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtPassword" Height="36" Padding="8,6" FontSize="12" BorderBrush="#D1D5DB" Margin="0,0,0,16"/>

            <!-- Error Message -->
            <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10" HorizontalAlignment="Center"/>

            <!-- Login CTA -->
            <Button x:Name="BtnLogin" Content="Sign in" Height="38" Background="#F59E0B" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Click="BtnLogin_Click"/>

            <TextBlock Text="Staff access only" FontSize="10" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>
    </Grid>
</Window>
