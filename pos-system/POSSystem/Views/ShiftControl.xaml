<UserControl x:Class="RMS.POSSystem.Views.ShiftControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="20">
        <StackPanel>
            <TextBlock Text="Cashier Shift &amp; Cash Drawer Management (KES)" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,15"/>

            <!-- Active Shift Panel (Shown when shift is open) -->
            <Border x:Name="ActiveShiftPanel" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Active Shift Session" FontWeight="Bold" FontSize="13" Foreground="#111827"/>
                        <Border Background="#ECFDF5" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                            <TextBlock Text="STATUS: OPEN" FontWeight="Bold" FontSize="10" Foreground="#065F46"/>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Shift Opened At:" FontSize="11" Foreground="#6B7280"/>
                        <TextBlock x:Name="TxtOpenTime" Text="2026-09-02 08:00 AM" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Opening Float Balance:" FontSize="11" Foreground="#6B7280"/>
                        <TextBlock x:Name="TxtOpenBalance" Text="KES 5,000.00" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Separator Background="#E5E7EB" Margin="0,5,0,12"/>

                    <!-- Close Shift Drawer Count Form -->
                    <TextBlock Text="End-of-Shift Cash Reconciliation (KES)" FontWeight="Bold" FontSize="12" Foreground="#111827" Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Actual Cash Counted in Drawer (KES):" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtActualCash" Height="34" Padding="6,4" FontSize="13" FontWeight="Bold" Text="5000.00" Margin="0,0,0,8"/>

                    <TextBlock Text="Shift Closing Notes / Handover:" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtClosingNotes" Height="40" Padding="6,4" FontSize="11" Text="End of morning cashier shift handover." Margin="0,0,0,12"/>

                    <Button x:Name="BtnCloseShift" Content="🔒 Reconcile &amp; Close Shift" Height="38" Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="BtnCloseShift_Click"/>
                </StackPanel>
            </Border>

            <!-- Start Shift Panel (Shown when no shift is open) -->
            <Border x:Name="NoShiftPanel" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel MaxWidth="400" HorizontalAlignment="Center">
                    <TextBlock Text="No Open Shift Found" FontSize="15" FontWeight="Bold" Foreground="#92400E" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Please enter your starting cash float in Kenyan Shillings to open a new cashier session." FontSize="11" Foreground="#B45309" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,15"/>

                    <TextBlock Text="Opening Float / Cash Drawer Balance (KES):" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtStartBalance" Height="36" Padding="8,6" FontSize="14" FontWeight="Bold" Text="5000.00" Margin="0,0,0,12"/>

                    <TextBlock Text="Starting Notes:" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtStartNotes" Height="36" Padding="6,4" FontSize="11" Text="Front desk morning float" Margin="0,0,0,15"/>

                    <Button x:Name="BtnOpenShift" Content="🔓 Start &amp; Open Shift (KES)" Height="40" Background="#F59E0B" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Click="BtnOpenShift_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
