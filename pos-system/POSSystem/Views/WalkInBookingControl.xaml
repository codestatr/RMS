<UserControl x:Class="RMS.POSSystem.Views.WalkInBookingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Property Selection & Guest Info -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Walk-In Guest Check-In (KES)" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,15"/>

                <!-- Property Dropdown -->
                <TextBlock Text="Select Rental Property" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbProperties" Height="36" FontSize="12" Margin="0,0,0,12" SelectionChanged="CmbProperties_SelectionChanged"/>

                <!-- Dates Grid -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Check-In Date" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpCheckIn" Height="32" SelectedDateChanged="Dates_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Check-Out Date" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpCheckOut" Height="32" SelectedDateChanged="Dates_Changed"/>
                    </StackPanel>
                </Grid>

                <!-- Guest Name & Phone -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Guest Full Name" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtGuestName" Height="32" Padding="6,4" FontSize="12" Text="Walk-in Guest"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Guest Phone Number" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtGuestPhone" Height="32" Padding="6,4" FontSize="12" Text="+254 700 000000"/>
                    </StackPanel>
                </Grid>

                <!-- Number of Guests -->
                <TextBlock Text="Number of Guests" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtGuestCount" Height="32" Padding="6,4" FontSize="12" Text="1" Margin="0,0,0,12"/>

                <!-- Special Requests -->
                <TextBlock Text="Special Requests (Optional)" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtSpecialRequests" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Padding="6,4" FontSize="11"/>
            </StackPanel>

            <!-- Right: Live Bill & Checkout in KES -->
            <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="15">
                <StackPanel VerticalAlignment="SpaceBetween">
                    <StackPanel>
                        <TextBlock Text="Live Order Summary (KES)" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,12"/>
                        
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Nightly Rate:" FontSize="11" Foreground="#6B7280"/>
                            <TextBlock x:Name="TxtRate" Text="KES 5,500.00" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Nights:" FontSize="11" Foreground="#6B7280"/>
                            <TextBlock x:Name="TxtNights" Text="1 Night" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Subtotal (Net):" FontSize="11" Foreground="#6B7280"/>
                            <TextBlock x:Name="TxtSubtotal" Text="KES 5,500.00" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="VAT Tax (16%):" FontSize="11" Foreground="#6B7280"/>
                            <TextBlock x:Name="TxtTax" Text="KES 880.00" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Margin="0,10" Background="#E5E7EB"/>

                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="TOTAL DUE (KES):" FontSize="13" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock x:Name="TxtTotal" Text="KES 6,380.00" FontSize="16" FontWeight="ExtraBold" Foreground="#D97706" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <Button x:Name="BtnProceedPayment" Content="💳 Proceed to Payment &rarr;" Height="42" Background="#F59E0B" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Click="BtnProceedPayment_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
