<UserControl x:Class="RMS.POSSystem.Views.TransactionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Terminal Transactions History (KES)" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                <Button Content="🔄 Refresh" Background="#F3F4F6" Foreground="#374151" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,4" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Click="BtnRefresh_Click"/>
            </Grid>

            <!-- Transactions DataGrid in KES -->
            <DataGrid Grid.Row="1" x:Name="DgTransactions" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E5E7EB" Background="White" RowHeight="32" FontSize="11">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Receipt #" Binding="{Binding ReceiptNumber}" Width="140"/>
                    <DataGridTextColumn Header="Guest Name" Binding="{Binding CustomerId}" Width="160"/>
                    <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="80"/>
                    <DataGridTextColumn Header="Amount (KES)" Binding="{Binding TotalAmount, StringFormat='KES {0:N2}'}" Width="120"/>
                    <DataGridTextColumn Header="Check-In" Binding="{Binding CheckInDate, StringFormat='yyyy-MM-dd'}" Width="100"/>
                    <DataGridTextColumn Header="Check-Out" Binding="{Binding CheckOutDate, StringFormat='yyyy-MM-dd'}" Width="100"/>
                    <DataGridTextColumn Header="Sync" Binding="{Binding SyncStatus}" Width="80"/>
                    <DataGridTemplateColumn Header="Action" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Reprint Receipt" Background="#F59E0B" Foreground="White" FontWeight="SemiBold" FontSize="10" Padding="8,2" BorderThickness="0" Click="BtnReprint_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
