<Application x:Class="RMS.POSSystem.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#20211F" />
        <SolidColorBrush x:Key="InkSoftBrush" Color="#2D2D2D" />
        <SolidColorBrush x:Key="MutedBrush" Color="#696D68" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F9F9F8" />
        <SolidColorBrush x:Key="LineBrush" Color="#DEDFDB" />
        <SolidColorBrush x:Key="AccentBrush" Color="#176B52" />
        <SolidColorBrush x:Key="AmberBrush" Color="#176B52" />
        <SolidColorBrush x:Key="AmberDarkBrush" Color="#145A46" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#C9CBC6" />
        <CornerRadius x:Key="PanelRadius">4</CornerRadius>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#17202A" />
            <Setter Property="Background" Value="#FBFCFC" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#17202A" />
            <Setter Property="Background" Value="#FBFCFC" />
            <Setter Property="BorderBrush" Value="#CBD5DC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#24313D" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#F9F9F8" />
            <Setter Property="HorizontalGridLinesBrush" Value="#ECEDE9" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F0ED" />
            <Setter Property="Foreground" Value="#696D68" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="#DEDFDB" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="46" />
        </Style>
    </Application.Resources>
</Application>
