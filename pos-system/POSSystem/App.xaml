<Application x:Class="RMS.POSSystem.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#17202A" />
        <SolidColorBrush x:Key="InkSoftBrush" Color="#24313D" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F5F7F8" />
        <SolidColorBrush x:Key="LineBrush" Color="#E4E9ED" />
        <SolidColorBrush x:Key="AmberBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5DC" />
        <CornerRadius x:Key="PanelRadius">10</CornerRadius>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#17202A" />
            <Setter Property="Background" Value="#FBFCFC" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#17202A" />
            <Setter Property="Background" Value="#FBFCFC" />
            <Setter Property="BorderBrush" Value="#CBD5DC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#24313D" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFB" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E9ED" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEF1F3" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF2F4" />
            <Setter Property="Foreground" Value="#53616B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="BorderBrush" Value="#DCE3E8" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="38" />
        </Style>
    </Application.Resources>
</Application>
