{
  "name": "rms-house-rental-system",
  "version": "1.0.0",
  "description": "House Rental & Booking Management System - Full Stack Application",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "admin-client",
    "shared"
  ],
  "scripts": {
    "install-all": "npm install",
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "backend:dev": "npm run dev --workspace=backend",
    "backend:build": "npm run build --workspace=backend",
    "frontend:dev": "npm run dev --workspace=frontend",
    "frontend:build": "npm run build --workspace=frontend",
    "admin:dev": "npm run dev --workspace=admin-client",
    "admin:build": "npm run build --workspace=admin-client",
    "stop": "taskkill /F /IM node.exe",
    "stop:ports": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 3000,5173,5176 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\""
  },
  "keywords": [
    "house-rental",
    "booking-system",
    "property-management",
    "airbnb-clone"
  ],
  "author": "Development Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
